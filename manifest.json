{
    "manifest_version": 3,  // Using the latest version
    "name": "WISE Clinical Context Assistant - WA",
    "version": "1.0",
    "description": "Summarizes medical webpages and extracts key info.",
    "permissions": [
      "activeTab",       // Permission to access the current browser tab
      "scripting"        // Permission to run scripts on the page
    ],
    "action": {
      "default_popup": "popup.html", // This file opens when you click the extension icon
      "default_icon": {              // You can add icons later
        "16": "images/icon16.png",
        "48": "images/icon48.png"
      }
    },
    "icons": {                       // You can add icons later
      "16": "images/icon16.png",
      "48": "images/icon48.png"
    }
  }