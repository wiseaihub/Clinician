{
    "manifest_version": 3,
    "name": "WISE Clinical Context Assistant - WA",
    "version": "2.1",
    "description": "Advanced clinical research tool with local data storage and intelligent website suggestions.",
    "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "downloads",
      "tabs"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png"
      }
    },
    "icons": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    }
}