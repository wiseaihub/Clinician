{
  "manifest_version": 3,
  "name": "WISE Clinical Assistant",
  "version": "2.2",
  "description": "Clinical research tool",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png"
  }
}