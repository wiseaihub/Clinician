{
  "manifest_version": 3,
  "name": "WISE Clinical Assistant",
  "version": "2.6",
  "description": "Clinical research tool",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/extension_icon.svg",
      "32": "images/extension_icon.svg",
      "48": "images/extension_icon.svg"
    }
  },
  "icons": {
    "16": "images/extension_icon.svg",
    "32": "images/extension_icon.svg",
    "48": "images/extension_icon.svg"
  }
}